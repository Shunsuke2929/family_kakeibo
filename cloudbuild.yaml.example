steps:
  - name: 'gcr.io/cloud-builders/docker'
    args:
      - 'build'
      - '-t'
      - 'gcr.io/$PROJECT_ID/family-kakeibo'
      - '.'

  - name: 'gcr.io/cloud-builders/docker'
    args:
      - 'push'
      - 'gcr.io/$PROJECT_ID/family-kakeibo'

  - name: 'gcr.io/google.com/cloudsdktool/cloud-sdk'
    entrypoint: 'gcloud'
    args:
      - 'run'
      - 'deploy'
      - 'family-kakeibo'
      - '--image'
      - 'gcr.io/$PROJECT_ID/family-kakeibo'
      - '--region'
      - 'YOUR_GCP_REGION'
      - '--platform'
      - 'managed'
      - '--update-env-vars'
      - '^|^FRONTEND_ORIGIN=https://YOUR_CLOUD_RUN_URL|HOUSEHOLD_ID=YOUR_HOUSEHOLD_ID|RECEIPT_TEMP_BUCKET=YOUR_GCS_BUCKET_NAME|DRIVE_SHARED_FOLDER_ID=YOUR_GOOGLE_DRIVE_FOLDER_ID|GEMINI_MODEL=gemini-2.5-flash|GEMINI_MODEL_FALLBACKS=gemini-2.5-flash-lite|GEMINI_FREE_ONLY=true|GEMINI_DEFAULT_MODEL_OPTION=free_gemini35|GEMINI_ALLOWED_MODEL_OPTIONS=free_gemini35,free_gemini25|GEMINI_ALLOWED_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite|GEMINI_MAX_OUTPUT_TOKENS=1536|GEMINI_MAX_RETRIES=1|GEMINI_DISABLE_PAID_FALLBACK=true|GEMINI_ENABLE_PAID_FALLBACK=false'
      - '--update-secrets'
      - 'GEMINI_FREE_API_KEY=YOUR_SECRET_NAME_FOR_GEMINI_FREE_KEY:latest'
      - '--remove-env-vars'
      - 'GEMINI_API_KEY,GOOGLE_API_KEY,GEMINI_MODEL_FALLBACK,GOOGLE_GENAI_USE_VERTEXAI,VERTEXAI_PROJECT,VERTEX_AI_PROJECT'
      - '--quiet'

  # Optional: Discord Release Notification Step
  # If you want to send a release notification to Discord, configure a secret in Secret Manager
  # and uncomment the following step:
  # - name: 'gcr.io/google.com/cloudsdktool/cloud-sdk'
  #   entrypoint: 'python3'
  #   env:
  #     - 'DISCORD_RELEASE_NOTIFICATION_REQUIRED=true'
  #   secretEnv:
  #     - 'DISCORD_RELEASE_WEBHOOK_URL'
  #   args:
  #     - 'scripts/send_discord_release_notification.py'

images:
  - 'gcr.io/$PROJECT_ID/family-kakeibo'

# availableSecrets:
#   secretManager:
#     - versionName: 'projects/$PROJECT_ID/secrets/YOUR_DISCORD_WEBHOOK_SECRET_NAME/versions/latest'
#       env: 'DISCORD_RELEASE_WEBHOOK_URL'
